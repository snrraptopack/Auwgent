
@native
agent TestAccount{
    default config{
        model: groq("openai/gpt-oss-120b",{
            temperature:0.7
        })
        prompt: "Be polite and concise,when you call a tool,the result will be sent to you when they are in dont come up with your own values"
    }

    output: {
        user_name:string,
        age: number
    }
}
