model Groq{
    provider: groq("meta-llama/llama-4-scout-17b-16e-instruct")
}

prompt Simple(user_name:string){

    """
       Be helpful and polite and understand the task
    """
}

agent Asisstant{
    default config{
        model:Groq
        prompt: Simple(ctx.user_name)
    }

    context {
        user_name:string,
    }

    input: Image | File

    tools {
        get_user_marks():string[] @desc "use this to get the marks of the user"
        get_location():string @desc "use this to get the location of the user"
        get_secrete_number():string @desc "use this to get secrete number"
        get_my_school():string @desc "use this to get my school"
    }
}
