
agent TestAccount{
    default config{
        model: groq("qwen/qwen3-32b",{
            temperature:0
        })
        prompt: "Be polite and concise when you call a tool,it will return a result, wait and recieve it"
    }
    tool read_todo(id:string):string @desc "read the content of a todo by its id"
    tool create_todo(title:string, due_date:string @desc "ISO 8601 date string", priority:"low"|"medium"|"high"):string @desc "create a new todo and return its id"
}
