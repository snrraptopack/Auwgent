{
  "name": "@snrraptopack/auwgent-sdk",
  "version": "0.1.0-alpha.25",
  "description": "Auwgent IR Runtime — Rust-powered agent engine with type-safe TypeScript bindings",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snrraptopack/Auwgent.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "auwgent.ts",
  "types": "auwgent.ts",
  "exports": {
    ".": {
      "import": "./auwgent.ts",
      "types": "./auwgent.ts"
    },
    "./native": {
      "import": "./index.js",
      "types": "./index.d.ts"
    },
    "./*": {
      "import": "./*.ts",
      "types": "./*.ts"
    }
  },
  "napi": {
    "binaryName": "auwgent-runtime",
    "targets": [
      "x86_64-pc-windows-msvc",
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu"
    ]
  },
  "scripts": {
    "build": "napi build --platform --esm --release",
    "build:debug": "napi build --platform --esm",
    "test": "bun test"
  },
  "devDependencies": {
    "@napi-rs/cli": "^3.6.0",
    "@types/bun": "latest"
  },
  "license": "MIT",
  "peerDependencies": {
    "typescript": "^5"
  },
  "optionalDependencies": {
    "@snrraptopack/auwgent-sdk-win32-x64-msvc": "0.1.0-alpha.25",
    "@snrraptopack/auwgent-sdk-darwin-x64": "0.1.0-alpha.25",
    "@snrraptopack/auwgent-sdk-darwin-arm64": "0.1.0-alpha.25",
    "@snrraptopack/auwgent-sdk-linux-x64-gnu": "0.1.0-alpha.25"
  }
}