type Person {
    name:string,
    age:number
    location:string @desc "location of the user"
}

agent Hello{
    default config{
        model:groq("openai/gpt-oss-120b")
        prompt: """
        Be polite helpful accurate.
        tools are avaialble for your use, use them to exute task effectively
        """
    }


    tool get_user_name_age():Person @desc "use this to get the user's name and age"
    tool get_location():string @desc "use this to ge location"

    output : Person
    helpers{Joker}
}


helper Joker{
    description: "Good at cracking jokes"

    default config{
        model:groq("openai/gpt-oss-120b")
        prompt: "You are a joker try to joke to the user"
    }
    input{ joker_prompt:string}
}
