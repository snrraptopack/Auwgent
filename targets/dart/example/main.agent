

type Person {
    name:string,
    age:number
    location?:string
}



agent Hello{
    default config{
        model:groq("openai/gpt-oss-120b")
        prompt: "You are a helper"
    }


    tool get_details():Person @desc "use this to get the deatails of the user"
    tool get_location(id:string):string @desc "use this to ge location"

    output : Person
    helpers{Joker}
}


helper Joker{
    description: "Good at cracking jokes"

    default config{
        model:groq("openai/gpt-oss-120b")
        prompt: "You are a joker try to joke to the user"
    }
    input{ joker_prompt:string}
}
