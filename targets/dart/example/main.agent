

type Person {
    name:string,
    age:number
}



agent Hello{
    default config{
        model:custom("groq-api","https://api.groq.com/openai/v1","openai/gpt-oss-120b")
        prompt: "You are a helper"
    }


    tool get_details():string @desc "use this to get the deatails of the user"
    tool get_location(id:string):string @desc "use this to ge location"

    output : Person
}
