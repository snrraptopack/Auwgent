export helper SecurityCodeAnalyzerHelper {
    description: "Specialized security auditor for code analysis"

    input {
        code: string
        language: string
        file_path: string
        context?: string
    }

    output: SecurityVulnerability[]

    tools {
        run_sast_scan(code: string, lang: string): string[] {
            description: "Run static application security testing"
        }
        check_dependency_vulns(imports: string[]): string[] {
            description: "Check for known vulnerabilities in dependencies"
        }
        lookup_cwe(pattern: string): string {
            description: "Look up CWE ID for a vulnerability pattern"
        }
    }

    workflow analyze_security(code: string, lang: string, path: string, ctxs: string): SecurityVulnerability[] {
        description: "Execute comprehensive security analysis"
        
        let sast_results = run_sast_scan(code, lang)
        let vulns: SecurityVulnerability[] = []
        
        return vulns
    }

    default config {
        model: GeminiModel
        prompt: SecurityAnalyzerPrompt
    }

    config owasp_strict {
        model: GeminiModel
        prompt {
            """
OWASP TOP 10 STRICT MODE

Mandatory checks for ALL categories:
1. A01:2021 - Broken Access Control
2. A02:2021 - Cryptographic Failures
3. A03:2021 - Injection
4. A04:2021 - Insecure Design
5. A05:2021 - Security Misconfiguration
6. A06:2021 - Vulnerable Components
7. A07:2021 - Auth Failures
8. A08:2021 - Integrity Failures
9. A09:2021 - Logging Failures
10. A10:2021 - SSRF

Flag ANYTHING suspicious. False positives > missed vulnerabilities.
"""
        }
    }
}

export helper PerformanceAnalyzerHelper {
    description: "Analyzes code for performance issues and optimization opportunities"

    input {
        code: string
        language: string
        hot_path: boolean
        context?: string
    }

    output: PerformanceIssue[]

    tools {
        analyze_complexity(code: string): string {
            description: "Compute time/space complexity analysis"
        }
        detect_n_plus_one(code: string): string[] {
            description: "Detect N+1 query patterns"
        }
        find_memory_leaks(code: string): string[] {
            description: "Static analysis for potential memory leaks"
        }
    }

    workflow analyze_performance(code: string, lang: string, hot: boolean, ctxs: string): PerformanceIssue[] {
        description: "Execute performance analysis pipeline"
        
        let complexity = analyze_complexity(code)
        let n1_issues = detect_n_plus_one(code)
        let leaks = find_memory_leaks(code)
        
        let issues: PerformanceIssue[] = []
        
        return issues
    }

    default config {
        model: GeminiModel
        prompt: PerformanceAnalyzerPrompt
    }
}

export helper TestCoverageAnalyzerHelper {
    description: "Identifies test coverage gaps and suggests test cases"

    input {
        code: string
        existing_tests?: string
        language: string
    }

    output: TestCoverageGap[]

    tools {
        parse_functions(code: string): string[] {
            description: "Extract function signatures from code"
        }
        map_test_coverage(code: string, tests: string): string {
            description: "Map which functions have test coverage"
        }
        generate_test_stub(func_signature: string, lang: string): string {
            description: "Generate a test stub for a function"
        }
    }

    workflow analyze_coverage(code: string, tests: string, lang: string): TestCoverageGap[] {
        description: "Identify gaps and suggest tests"
        
        let functions = parse_functions(code)
        let coverage_map = map_test_coverage(code, tests)
        
        let gaps: TestCoverageGap[] = []
        
        return gaps
    }

    default config {
        model: GeminiModel
        prompt: TestCoverageAnalyzerPrompt
    }
}

