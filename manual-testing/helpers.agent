export helper ResolutionSuggesterHelper {
    description: "Suggests optimal resolutions for support tickets"

    input {
        ticket_summary: string
        category: string
        sentiment: SentimentAnalysis
        customer_tier: string
    }

    output: ResolutionSuggestion[]

    tools {
        search_knowledge_base(query: string): string[] {
            description: "Search internal knowledge base for solutions"
        }
        find_similar_tickets(summary: string, limit: number): string[] {
            description: "Find similar resolved tickets"
        }
        check_known_issues(category: string): string[] {
            description: "Check for known issues in this category"
        }
        draft_response(template: string, context: string): string {
            description: "Generate a draft response from template"
        }
    }

    workflow suggest_resolutions(summary: string, cat: string, sentiment: SentimentAnalysis, tier: string): ResolutionSuggestion[] {
        description: "Generate ranked resolution suggestions"
        
        let kb_results = search_knowledge_base(summary)
        let similar = find_similar_tickets(summary, 5)
        let known = check_known_issues(cat)
        
        let suggestions: ResolutionSuggestion[] = []
        
        // Factor in sentiment for human requirement
        if (sentiment.escalation_risk > 0.7) {
            return [{
                approach: "Immediate human escalation recommended",
                confidence: 0.95,
                requires_human: true,
                estimated_time_minutes: 15,
                similar_resolved_tickets: similar
            }]
        }
        
        return suggestions
    }

    default config {
        model: GeminiModel
        prompt: ResolutionSuggesterPrompt
    }

    config vip_mode {
        model: GeminiModel
        prompt {
            """
VIP CUSTOMER RESOLUTION MODE

This is a high-value customer. Apply premium service standards:
- Proactive compensation consideration
- Personalized response (no templates)
- Executive escalation path always available
- Follow-up commitment required
- Satisfaction guarantee messaging

Never suggest self-service for VIP customers.
Human touch is mandatory.
"""
        }
    }
}