}

export helper FactCheckerHelper {
    description: "Rigorously verifies claims against multiple sources"

    input {
        claim: string
        strictness: string
    }

    output: FactCheckResult

    tools {
        search_fact_databases(claim: string): string[] {
            description: "Search fact-checking databases (Snopes, PolitiFact, etc.)"
        }
        find_primary_source(claim: string): string {
            description: "Attempt to locate the original source of a claim"
        }
        cross_reference(claim: string, sources: string[]): string {
            description: "Cross-reference claim across multiple sources"
        }
    }

    workflow verify_claim(claim: string, ctxs: string, strict: string): FactCheckResult {
        description: "Execute comprehensive fact verification pipeline"
        
        let db_results = search_fact_databases(claim)
        let primary = find_primary_source(claim)
        
        // Determine verdict based on evidence
        return {
            claim: claim,
            verdict: "unverifiable",
            explanation: "Insufficient evidence found. Primary source: " + primary,
            sources: db_results
        }
    }

    default config {
        model: GeminiModel
        prompt: FactCheckerPrompt
    }

    config strict_mode {
        model: GeminiModel
        prompt {
            """
STRICT VERIFICATION MODE ENGAGED.

Apply maximum rigor:
- Require 3+ independent sources for "verified" verdict
- Any contradiction triggers "partially_true" at best
- Date-check all sources - reject anything > 2 years old for current events
- Flag ANY unverifiable claim explicitly
"""
        }
    }
}

