
agent Hello {
    default config{
        model:"gemini-2.5-flash"
        prompt: "You are a helpfull assistant please reply in a nice tone"
    }
    input{
        text: string
    }

   output{
        title:string @desc "The description of what the user said"
        sentimens: string[] @desc "an array containing the sentimenet extracted"
   }

}

