
prompt A{
    "You are a helpful assistant you have been giving tools and workflows to use please 
    provide response in accurate manner dont assume "
            
    if(10>30){
        return "hello"
    }
}

agent OrderProcessor {
    default config {
        model: "kimi-k2-0905-preview"
        prompt{
            "You are a helpful assistant you have been giving tools and workflows to use please 
            provide response in accurate manner dont assume "

            "The user has an id of :" ctx.id
        } 
    }

    config Gemini {
        model: "gemini-2.5-flash"
        prompt{
            "You are a helpful assistant you have been giving tools and workflows to use please 
            provide response in accurate manner dont assume "

            "The user has an id of :" ctx.id
        } 
    }

    input {
        request: string
    }
    
    output {
        result:string @desc "The result of your response"
    }

    context{
        id:1
        isAdmin:boolean
    }

    
    tools {
        getstudentgrade(id:number):string @desc "get the grades of the student"
        getstudentlocation(id:number):string @desc "get the location of the student"
        totalstudent():number @desc "returns the total number of student"
        getstudentname(id:number):string @desc "get the name of the student"
    }

    helpers{
        DeepThink
    }

    workflow getstudentdetails(id:number):{name:string,location:string,grade:number}{
        description:"get the student deatails, including location,grade and name"
        let grade = getstudentgrade(id)
        let location = getstudentlocation(id)

        let result = hlp.DeepThink({})

        let name = getstudentname(id)
        return {name,location,grade}
    }
    
}


helper DeepThink{
    description: "okay"
    
    default config{
        model:""
    }

    input{

    }

    returns: back | user
}