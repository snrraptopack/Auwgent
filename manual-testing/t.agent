
agent Hello {
    default config{
        model:"gemini-2.5-flash"
        prompt: "You are a helpfull assistant please reply in a nice tone"
    }
    input{
        text: string
    }

    tool getLoction():string{
        description:"get the user location"
    }
    tool getWeather():string{
        description: "get the weather for a location"
    }

    workflow checkWeatherflow():string{
        description: "This checks the weather contains all the tools to do that at once given you one unified feedback"
        let location = getLoction()
        let weather = getWeather()
        return weather
    }

}

