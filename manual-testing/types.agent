export type IncidentReport{
    id:string
    severity:string
    category:string
    descriptions:string
    affected_assets:string[]
    owner_team:string
    primary_asset:string
    sla_minutes?:number
}

export type Brief{
    summary:string
    highlights:string[]
}

export type RoutingDecision{
    channel:string
    reasons:string[]
}

export type ActionPlan{
    steps:string[]
    owner:string
    notes?:string
}

export type CoordinatorOutput{
    summary:string @desc "High level summary for downstream stakeholders"
    action_plan:ActionPlan
    follow_up:boolean
    escalations?:string[]
    audit_log?:string
}

export type SecurityScanResult{
    status:string
    findings:string[]
    risk_score:number
}

export type SecurityHandoffPayload{
    ticket:string
    summary:string
    assets:string[]
    primary_asset:string
    priority:string
}

export output type ArchitectureRecommendation{
    proposal:string
    impact_summary:string
    effort:string
    open_questions?:string[]
}

export type ArchitectureReviewRequest{
    descriptions:string
    context:string
    impact_area:string
}

// ═══════════════════════════════════════════════════════════════════════════════
// RESEARCH SYSTEM TYPES
// ═══════════════════════════════════════════════════════════════════════════════

export output type ResearchQuery {
    topic: string
    depth: string @desc "shallow | moderate | deep | exhaustive"
    focus_areas: string[]
    constraints?: string[]
    deadline_hours?: number
}

export output type SourceDocument {
    id: string
    title: string
    url?: string
    content_snippet: string
    relevance_score: number
    credibility: string @desc "high | medium | low | unverified"
    publication_date?: string
}

export output type ResearchFinding {
    claim: string
    confidence: number @desc "0.0 to 1.0 confidence score"
    supporting_sources: string[]
    contradicting_sources?: string[]
    requires_verification: boolean
}

export output type SynthesizedInsight {
    key_insight: string
    evidence_strength: string @desc "strong | moderate | weak | speculative"
    implications: string[]
    related_findings: string[]
}

export output type ResearchReport {
    executive_summary: string @desc "2-3 sentence high-level summary"
    methodology: string
    key_findings: ResearchFinding[]
    synthesized_insights: SynthesizedInsight[]
    knowledge_gaps: string[]
    recommendations: string[]
    confidence_assessment: string
    sources_consulted: number
    further_research_needed: boolean
}

export output type FactCheckResult {
    claim: string
    verdict: string @desc "verified | partially_true | misleading | false | unverifiable"
    explanation: string
    sources: string[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// CODE REVIEW SYSTEM TYPES
// ═══════════════════════════════════════════════════════════════════════════════

export type CodeSubmission {
    id: string
    author: string
    language: string
    files: CodeFile[]
    commit_message: string
    branch: string
    target_branch: string
}

export type CodeFile {
    path: string
    content: string
    additions: number
    deletions: number
    is_new: boolean
}

export type CodeIssue {
    severity: string @desc "critical | high | medium | low | info"
    category: string @desc "security | performance | maintainability | correctness | style"
    file: string
    line_start: number
    line_end?: number
    title: string
    description: string
    suggestion?: string
    auto_fixable: boolean
}

export type SecurityVulnerability {
    cwe_id?: string
    owasp_category?: string
    severity: string
    attack_vector: string
    affected_code: string
    remediation: string
    references: string[]
}

export type PerformanceIssue {
    type: string @desc "time_complexity | space_complexity | io_bottleneck | memory_leak | n+1_query"
    impact: string @desc "critical | significant | moderate | minor"
    location: string
    current_complexity?: string
    suggested_complexity?: string
    optimization_hint: string
}

export type TestCoverageGap {
    file: string
    uncovered_functions: string[]
    suggested_test_cases: string[]
    risk_assessment: string
}

export output type CodeReviewReport {
    summary: string
    approval_status: string @desc "approved | request_changes | needs_discussion"
    issues: CodeIssue[]
    security_findings: SecurityVulnerability[]
    performance_concerns: PerformanceIssue[]
    test_coverage_gaps: TestCoverageGap[]
    positive_highlights: string[]
    overall_quality_score: number @desc "1-10 quality score"
    estimated_review_confidence: number
    requires_senior_review: boolean
}

// ═══════════════════════════════════════════════════════════════════════════════
// DATA PIPELINE ORCHESTRATOR TYPES
// ═══════════════════════════════════════════════════════════════════════════════

export output type DataSource {
    id: string
    type: string @desc "database | api | file | stream"
    connection_string: string
    schema?: string
    refresh_frequency?: string
}

export type TransformationStep {
    name: string
    type: string @desc "filter | map | aggregate | join | pivot | normalize"
    config: string
    dependencies: string[]
}

export output type DataQualityCheck {
    check_type: string @desc "completeness | accuracy | consistency | timeliness | uniqueness"
    target_field: string
    threshold: number
    actual_value?: number
    passed: boolean
    details?: string
}

export output type PipelineStage {
    stage_name: string
    status: string @desc "pending | running | completed | failed | skipped"
    started_at?: string
    completed_at?: string
    records_processed?: number
    errors?: string[]
}

export output type PipelineExecutionReport {
    pipeline_id: string
    execution_id: string
    status: string @desc "success | partial_success | failed"
    stages: PipelineStage[]
    quality_checks: DataQualityCheck[]
    total_records_processed: number
    total_errors: number
    duration_seconds: number
    data_lineage_hash: string
    recommendations: string[]
}

// ═══════════════════════════════════════════════════════════════════════════════
// CUSTOMER SUPPORT ESCALATION TYPES
// ═══════════════════════════════════════════════════════════════════════════════

export output type CustomerProfile {
    id: string
    tier: string @desc "free | pro | enterprise | vip"
    account_age_days: number
    lifetime_value: number
    open_tickets: number
    satisfaction_score?: number
    tags: string[]
}

export output type SupportTicket {
    id: string
    customer_id: string
    subject: string
    description: string
    category: string
    priority: string
    created_at: string
    messages: TicketMessage[]
    attachments?: string[]
}

export output type TicketMessage {
    sender: string @desc "customer | agent | system"
    content: string
    timestamp: string
    sentiment?: string
}

export output type SentimentAnalysis {
    overall: string @desc "positive | neutral | negative | frustrated | angry"
    confidence: number
    escalation_risk: number @desc "0.0 to 1.0"
    key_emotions: string[]
    trigger_phrases: string[]
}

export type ResolutionSuggestion {
    approach: string
    confidence: number
    requires_human: boolean
    estimated_time_minutes: number
    similar_resolved_tickets: string[]
}

export output type SupportAnalysis {
    ticket_summary: string
    sentiment: SentimentAnalysis
    category_classification: string
    urgency_score: number @desc "1-10"
    suggested_resolutions: ResolutionSuggestion[]
    escalation_recommended: boolean
    escalation_reason?: string
    auto_response_draft?: string
    knowledge_base_articles: string[]
    requires_specialist: boolean
    specialist_type?: string
}
