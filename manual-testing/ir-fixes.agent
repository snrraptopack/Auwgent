
agent Issues{
    input{issue:string}
    output:{
        summary:string
        category:"bug" |"performance" |"feature_request" | "question" | "unknown"
        suspectedCause:string
        nextStep:string
    }

    default config{
        model:openai("gpt")
        prompt{
            """
            Analyze the following software issue and return a structured response.
            Issue:{{input.issue}}
            """
        }
    }
}