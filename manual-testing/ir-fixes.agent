import { Base } from "./prompt"

type User {
    name: string
}

agent IRFixes {
    default config {
        model: gemini("")
        prompt: Base + """Hello {{ctx.user.name}}
            Input: {{input.message}}
        """ 
    }

    input { message: string }
    context { user: User }

    workflow combine(a: string, b: string): string {
        description: "Combine strings"
        let c = a + b
        return c
    }
}
