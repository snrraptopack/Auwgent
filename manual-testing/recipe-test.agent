// Helper 1: Ingredient analyzer
helper IngredientAnalyzer {
    description: "Analyzes available ingredients and suggests what can be made. Use this first before creating recipes."
    
    default config {
        model: "gemini-2.5-flash"
        prompt: "You analyze ingredients and suggest what types of dishes could be made with them. Be concise."
    }
    
    input {
        ingredients: string
    }
    
    output {
        analysis: string @desc "What can be made with these ingredients"
        cuisineType: string @desc "Suggested cuisine type"
    }
    
    returns: back
}

// Helper 2: Recipe creator
helper RecipeCreator {
    description: "Creates detailed recipes based on cuisine type and ingredients. Only use after analyzing ingredients."
    
    default config {
        model: "gemini-2.5-flash"
        prompt: "You are a professional chef. Create detailed, step-by-step recipes. Include cooking times and tips."
    }
    
    input {
        cuisineType: string
        ingredients: string
    }
    
    output {
        recipeName: string @desc "Name of the recipe"
        instructions: string @desc "Step-by-step cooking instructions"
        cookingTime: string @desc "Total cooking time"
    }
    
    returns: back
}

// Main agent with workflow
agent Chef {
    helpers {
        IngredientAnalyzer
        RecipeCreator
    }
    
    default config {
        model: "kimi-k2-0905-preview"
        prompt {
            "You are a helpful cooking assistant."
            "You have access to two helpers and one workflow:"
            "- IngredientAnalyzer: Analyzes what can be made from ingredients"
            "- RecipeCreator: Creates detailed recipes"
            "- createRecipe workflow: COMBINES BOTH - first analyzes ingredients, then creates a recipe. USE THIS for full meal creation."
            "When user wants a complete meal suggestion, use the createRecipe workflow (NOT the helpers directly)."
        }
    }
    
    input {
        request: string
    }
    
    output {
        result: string @desc "Your response"
    }
    
    // Workflow that chains both helpers
    workflow createRecipe(ingredients: string): string {
        description: "Creates a complete recipe by first analyzing ingredients then generating a detailed recipe. USE THIS for full meal creation requests."
        let analysis = hlp.IngredientAnalyzer({ ingredients: ingredients })
        let recipe = hlp.RecipeCreator({ cuisineType: "based on analysis", ingredients: ingredients })
        return recipe
    }
}
