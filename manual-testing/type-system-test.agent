output type ExtractedResume {
    name:string
    title?:string
    experience:string // Experience but because it not provided let use string
    skills:string[]
}

agent ExtractResume{
    input{text:string}
    output {response: ExtractedResume @desc "The resume extracted"}

    default config{
        model:openai("openai/gpt-40")
        prompt: "You are resume parser extract the following resume text attached by the user"
    }
}