{
  "name": "MainAgent",
  "modelConfig": [
    {
      "defaultConfig": {
        "model": {
          "type": "openai",
          "modelName": "gpt-4"
        },
        "prompt": {
          "type": "parts",
          "value": [
            {
              "type": "promptRef",
              "name": "WelcomePrompt",
              "value": [
                {
                  "value": "Welcome to the system!",
                  "type": "literal"
                },
                {
                  "value": "Please provide your information.",
                  "type": "literal"
                }
              ]
            },
            {
              "value": "Processing user data...",
              "type": "literal"
            }
          ]
        }
      },
      "namedConfig": []
    }
  ],
  "input": {
    "user": {
      "type": {
        "type": "typeRef",
        "name": "User"
      },
      "optional": false
    }
  },
  "output": {
    "result": {
      "type": "string",
      "optional": false,
      "description": "Processing result"
    }
  },
  "context": null,
  "tools": [],
  "workflows": [],
  "helpers": [
    {
      "name": "DataFetcher",
      "description": "Fetches data from external sources",
