      "input": {
        "url": {
          "type": "string",
          "optional": false
        }
      },
      "output": {
        "data": {
          "type": "string",
          "optional": false,
          "description": "The fetched data"
        }
      },
      "context": null,
      "tools": [],
      "workflows": []
    }
  ],
  "types": {
    "User": {
      "isOutput": false,
      "properties": {
        "name": {
          "type": "string",
          "optional": false
