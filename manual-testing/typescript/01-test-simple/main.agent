
type Project{
     project_name: string
     tasks: {
         title: string
         priority: "low" | "medium" | "high"
         completed?: boolean
     }[]
}

agent TestProject{
    default config{
        model: custom("groq-api","https://api.groq.com/openai/v1","llama-3.3-70b-versatile")
        prompt: "Be polite and concise"
    }
    output: Project
}
