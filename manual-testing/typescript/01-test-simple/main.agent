type Company {
     company: {
         name: string
         departments: {
             dept_name: string
             employees: {
                 name: string
                 role: string
                 salary?: number
             }[]
         }[]
     }
 }

agent TestCompany{
    default config{
        model: custom("groq-api","https://api.groq.com/openai/v1","llama-3.3-70b-versatile")
        prompt: "Be polite and concise"
    }
    output: Company
}
