// This manual test is for basic input and out
//
// in the sdk the intent that would should be generated is response_text
// Text is made to compiled to null where the  engine takes over

agent Main{
    default config {
        model: custom("kimi","https://api.moonshot.ai/v1/chat/completions","kimi-k2-0905-preview")
        prompt: "You are a helper be polite"
    }
    input: Text
    output : Text

}
