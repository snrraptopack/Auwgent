
export type Address {
    street: string
    city: string
    zip: string
    country: string
}

export type ContactInfo{
    email: string
    phone: string
    address: Address
}

export type PricingTier {
    name: string
    monthly_cost: number
    annual_cost: number
    max_seats: number
}

export type Feature {
    id: string
    label: string
    enabled: boolean
    config: {
        limit: number
        unit: string
        overage_rate: number
    }
}

export type Subscription{
    id: string
    tier: PricingTier
    features: Feature[]
    started_at: string
    renews_at: string
    is_active: boolean
}

export type Organization {
    id: string
    name: string
    contact: ContactInfo
    subscription: Subscription
    member_count: number
    tags: string[]
}@example(
    id = "abc",
    name = "any name",
    contact = '.... and so on'
)

agent MainAgent{

    default config{
        model:custom("my-groq-api", "https://api.groq.com/openai/v1/chat/completions", "llama-3.3-70b-versatile",{
            enable_thinking: false,
            temperature: 0.7
            })
        prompt: {
            """
                You are a helpful assistant please your response should accurately be in this strcuture
                {{@schema(output)}}

                please [schema:Name] the name should match the schema we are using this case we have Organization
            """
        }
    }
    output:Organization
}
