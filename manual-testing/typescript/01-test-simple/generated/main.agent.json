          "modelName": "llama-3.3-70b-versatile",
          "config": {
            "type": "object",
            "value": {
              "enable_thinking": {
                "type": "literal",
                "value": false
              },
              "temperature": {
                "type": "literal",
                "value": 0.7
              }
            }
          }
        },
        "embedding": null,
        "prompt": {
          "type": "inlinePrompt",
