// This manual test is for a workflow
// with variable declaration and condition


agent Main{
    default config {
        model: gemini("gemini-2.5-flash")
        prompt: "You are a helper be polite"
    }
    input: Text
    output:Text

    workflow first(value:number):string{
        description: "The description for the workflow mandatory"
        let local_number = 10

        if (local_number > value){
            return "yes"
        }
        return "no"
    }

}
