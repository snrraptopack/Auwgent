
component Button {
    action : {
        onclick : "delete"
    }
}

agent Assistants{

    default config{
        model: gemini("gemini-2.5-flash")
        prompt {
        """
            You are an assistant agent please be polite to the user
            the user name is {{ctx.user_name}}
        """
        }
    }
    context {
        user_name:string
    }

}
