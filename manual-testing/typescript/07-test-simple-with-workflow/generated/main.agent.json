          "body": [
            {
              "type": "variableDeclaration",
              "name": "users",
              "value": {
                "type": "functionCall",
                "value": "db_query_users",
                "args": [
                  {
                    "type": "literal",
                    "value": "all"
                  }
                ]
              }
            },
            {
              "type": "variableDeclaration",
              "name": "products",
              "value": {
                "type": "functionCall",
                "value": "db_query_products",
                "args": [
                  {
                    "type": "literal",
