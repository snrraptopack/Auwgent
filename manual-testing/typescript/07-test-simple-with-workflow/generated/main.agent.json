              "explain": {
                "type": "literal",
                "value": "I'm querying the database to find all users..."
              }
            }
          ]
        }
      ],
      "modelConfig": [
        {
          "defaultConfig": {
            "model": {
              "type": "custom",
              "id": "my-groq-api",
              "url": "https://api.groq.com/openai/v1/chat/completions",
              "modelName": "openai/gpt-oss-120b"
            },
            "prompt": {
              "type": "inlinePrompt",
              "parts": [
                {
                  "type": "template",
                  "value": [
                    {
                      "type": "literal",
                      "value": "\r\n            You are a report generation specialist. Create well-formatted, professional reports.\r\n\r\n            Your reports should include:\r\n            - Executive summary\r\n            - Key metrics\r\n            - Detailed breakdowns\r\n            - Visual data representations (as text)\r\n            - Actionable recommendations\r\n            "
                    }
                  ]
                }
              ]
            }
          },
          "namedConfig": []
        }
      ],
      "input": {
        "kind": "direct",
        "type": {
          "type": "object",
          "properties": {
            "report_type": {
              "type": "string",
              "optional": false
            },
            "parameters": {
              "type": "string",
              "optional": false
            }
          }
        }
      },
      "output": {
        "type": {
          "type": "object",
          "properties": {
            "report_title": {
              "type": "string",
              "optional": false
            },
            "summary": {
              "type": "string",
              "optional": false
            },
            "sections": {
              "type": {
                "type": "array",
                "items": "string"
              },
              "optional": false
            },
            "generated_at": {
              "type": "string",
              "optional": false
            }
          }
        }
      },
      "context": null,
      "tools": [
        {
          "description": "Format data as a text table",
          "params": {
            "data": {
              "type": "string",
              "optional": false
            }
          },
          "name": "format_table",
          "returns": "string",
          "examples": [
            {
              "data": {
                "type": "literal",
                "value": "user1,John,john@example.com"
              }
            }
          ]
        },
