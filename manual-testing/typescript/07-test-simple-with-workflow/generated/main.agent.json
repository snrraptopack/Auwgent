{
  "name": "Main",
  "modelConfig": [
    {
      "defaultConfig": {
        "model": {
          "type": "custom",
          "id": "my-groq-api",
          "url": "https://api.groq.com/openai/v1/chat/completions",
          "modelName": "openai/gpt-oss-120b"
        },
        "prompt": {
          "type": "inlinePrompt",
          "parts": [
            {
              "type": "template",
              "value": [
                {
                  "type": "literal",
                  "value": "\r\n            You are a helpful database assistant. You can:\r\n            - Query users, products, and orders from the in-memory database\r\n            - Create new records\r\n            - Analyze data and generate reports\r\n            - Hand off complex analysis to specialized helpers\r\n\r\n            When users ask for data analysis, use the DataAnalyzer helper.\r\n            When users ask for reports, use the ReportGenerator helper.\r\n            "
                }
              ]
            }
          ]
        }
      },
      "namedConfig": []
    }
  ],
  "input": null,
  "output": {
    "__variants": {
      "QueryResult": {
        "success": {
          "type": "boolean",
          "optional": false
        },
        "data": {
          "type": "string",
          "optional": false
        },
        "message": {
          "type": "string",
          "optional": false
        }
      },
      "AnalysisReport": {
        "total_users": {
          "type": "number",
          "optional": false
        },
        "total_products": {
          "type": "number",
          "optional": false
        },
        "total_orders": {
          "type": "number",
          "optional": false
        },
        "revenue": {
          "type": "number",
          "optional": false
        },
        "insights": {
          "type": {
            "type": "array",
            "items": "string"
          },
          "optional": false
        }
      }
    }
  },
  "context": {
    "is_vip": {
      "type": "boolean",
      "optional": false
    },
    "user_id": {
      "type": "string",
      "optional": false
    },
    "session_id": {
      "type": "string",
      "optional": false
    }
  },
  "tools": [
    {
      "description": "Query users from in-memory DB. Filter can be 'all', 'id:<id>', 'email:<email>'",
      "params": {
        "filter": {
          "type": "string",
          "optional": false
        }
      },
      "name": "db_query_users",
      "returns": "string",
      "examples": [
        {
          "filter": {
            "type": "literal",
            "value": "all"
          }
        },
        {
          "filter": {
            "type": "literal",
            "value": "email:example@gmail.com"
          }
        },
        {
          "filter": {
            "type": "literal",
            "value": "id:user_1"
          }
        }
      ]
    },
    {
      "description": "Query products from in-memory DB. Filter can be 'all', 'id:<id>', 'name:<name>'",
      "params": {
        "filter": {
          "type": "string",
          "optional": false
        }
      },
      "name": "db_query_products",
      "returns": "string",
      "examples": [
        {
          "filter": {
            "type": "literal",
            "value": "all"
          }
        }
      ]
    },
    {
      "description": "Query orders from in-memory DB. Filter can be 'all', 'user_id:<id>', 'status:<status>'",
      "params": {
        "filter": {
          "type": "string",
          "optional": false
        }
      },
      "name": "db_query_orders",
      "returns": "string",
      "examples": [
        {
          "filter": {
            "type": "literal",
            "value": "all"
          }
        }
      ]
    },
    {
      "description": "Create a new user in the database",
      "params": {
        "name": {
          "type": "string",
          "optional": false
        },
        "email": {
          "type": "string",
          "optional": false
        }
      },
      "name": "db_create_user",
      "returns": "string",
      "examples": [
        {
          "name": {
            "type": "literal",
            "value": "John Doe"
          },
          "email": {
            "type": "literal",
            "value": "john@example.com"
          }
        }
      ]
    },
    {
      "description": "Create a new product in the database",
      "params": {
        "name": {
          "type": "string",
          "optional": false
        },
        "price": {
          "type": "number",
          "optional": false
        },
        "stock": {
          "type": "number",
          "optional": false
        }
      },
      "name": "db_create_product",
      "returns": "string",
      "examples": [
        {
          "name": {
            "type": "literal",
            "value": "Laptop"
          },
          "price": {
            "type": "literal",
            "value": 999.99
          },
          "stock": {
            "type": "literal",
            "value": 50.0
          }
        }
      ]
    },
    {
      "description": "Create a new order in the database",
      "params": {
        "user_id": {
          "type": "string",
          "optional": false
        },
        "product_id": {
          "type": "string",
          "optional": false
        },
        "quantity": {
          "type": "number",
          "optional": false
        }
      },
      "name": "db_create_order",
      "returns": "string",
      "examples": [
        {
          "user_id": {
            "type": "literal",
            "value": "user_1"
          },
          "product_id": {
            "type": "literal",
            "value": "prod_1"
          },
          "quantity": {
            "type": "literal",
            "value": 2.0
          }
        }
      ]
    }
  ],
  "workflows": [
    {
      "flowName": "get_user_orders",
      "flowParams": {
        "target_user_id": {
          "type": "string",
          "optional": false
        }
      },
      "returns": "string",
      "body": [
        {
          "type": "variableDeclaration",
          "name": "user_data",
          "value": {
            "type": "functionCall",
            "value": "db_query_users",
            "args": [
              {
                "type": "binaryOp",
                "op": "+",
                "left": {
                  "type": "literal",
                  "value": "id:"
                },
                "right": {
                  "type": "varRef",
                  "value": "target_user_id"
                }
              }
            ]
          }
        },
        {
          "type": "variableDeclaration",
          "name": "orders_data",
          "value": {
            "type": "functionCall",
            "value": "db_query_orders",
            "args": [
              {
                "type": "binaryOp",
                "op": "+",
                "left": {
                  "type": "literal",
                  "value": "user_id:"
                },
                "right": {
                  "type": "varRef",
                  "value": "target_user_id"
                }
              }
            ]
          }
        },
        {
          "type": "variableDeclaration",
          "name": "products_data",
          "value": {
            "type": "functionCall",
            "value": "db_query_products",
            "args": [
              {
                "type": "literal",
                "value": "all"
              }
            ]
          }
        },
        {
          "type": "return",
          "value": {
            "type": "binaryOp",
            "op": "+",
            "left": {
              "type": "binaryOp",
              "op": "+",
              "left": {
                "type": "binaryOp",
                "op": "+",
                "left": {
                  "type": "binaryOp",
                  "op": "+",
                  "left": {
                    "type": "binaryOp",
                    "op": "+",
                    "left": {
                      "type": "literal",
                      "value": "User: "
                    },
                    "right": {
                      "type": "varRef",
                      "value": "user_data"
                    }
                  },
                  "right": {
                    "type": "literal",
                    "value": "\\nOrders: "
                  }
                },
                "right": {
                  "type": "varRef",
                  "value": "orders_data"
                }
              },
              "right": {
                "type": "literal",
                "value": "\\nProducts: "
              }
            },
            "right": {
              "type": "varRef",
              "value": "products_data"
            }
          }
        }
      ],
      "description": "Get all orders for a specific user with product details",
      "tools": [],
      "examples": [
        {
          "target_user_id": {
            "type": "literal",
            "value": "user_1"
          }
        },
        {
          "target_user_id": {
            "type": "literal",
            "value": "user_1"
          }
        }
      ]
    },
    {
      "flowName": "calculate_revenue",
      "flowParams": {},
      "returns": "string",
      "body": [
        {
          "type": "variableDeclaration",
          "name": "completed_orders",
          "value": {
            "type": "functionCall",
            "value": "db_query_orders",
            "args": [
              {
                "type": "literal",
                "value": "status:completed"
              }
            ]
          }
        },
        {
          "type": "variableDeclaration",
          "name": "total_revenue",
          "value": {
            "type": "functionCall",
            "value": "sum_order_totals",
            "args": [
              {
                "type": "varRef",
                "value": "completed_orders"
              }
            ]
          }
        },
        {
          "type": "if",
          "condition": {
            "type": "comparison",
            "operator": ">",
            "left": {
              "type": "varRef",
              "value": "total_revenue"
            },
            "right": {
              "type": "literal",
              "value": 10000.0
            }
          },
          "then": [
            {
              "type": "return",
              "value": {
                "type": "binaryOp",
                "op": "+",
                "left": {
                  "type": "literal",
                  "value": "Excellent! Total revenue: $"
                },
                "right": {
                  "type": "varRef",
                  "value": "total_revenue"
                }
              }
            }
          ],
          "else": []
        },
        {
          "type": "return",
          "value": {
            "type": "binaryOp",
            "op": "+",
            "left": {
              "type": "literal",
              "value": "Total revenue: $"
            },
            "right": {
              "type": "varRef",
              "value": "total_revenue"
            }
          }
        }
      ],
      "description": "Calculate total revenue from all completed orders",
      "tools": [
        {
          "description": "Parse orders JSON and sum totals",
          "params": {
            "orders_json": {
              "type": "string",
              "optional": false
            }
          },
          "name": "sum_order_totals",
          "returns": "number"
        }
      ],
      "examples": [
        {},
        {}
      ]
    },
    {
      "flowName": "process_bulk_order",
      "flowParams": {
        "target_user_id": {
          "type": "string",
          "optional": false
        },
        "product_ids": {
          "type": "string",
          "optional": false
        },
        "quantities": {
          "type": "string",
          "optional": false
        }
      },
      "returns": "string",
      "body": [
        {
          "type": "if",
          "condition": {
            "type": "contextRef",
            "property": "is_vip"
          },
          "then": [
            {
              "type": "variableDeclaration",
              "name": "products",
              "value": {
                "type": "functionCall",
                "value": "parse_csv",
                "args": [
                  {
                    "type": "varRef",
                    "value": "product_ids"
                  }
                ]
              }
            },
            {
              "type": "variableDeclaration",
              "name": "qtys",
              "value": {
                "type": "functionCall",
                "value": "parse_csv",
                "args": [
                  {
                    "type": "varRef",
                    "value": "quantities"
                  }
                ]
              }
            },
            {
              "type": "variableDeclaration",
              "name": "order1",
              "value": {
                "type": "functionCall",
                "value": "db_create_order",
                "args": [
                  {
                    "type": "varRef",
                    "value": "target_user_id"
                  },
                  {
                    "type": "varRef",
                    "value": "products"
                  },
                  {
                    "type": "varRef",
                    "value": "qtys"
                  }
                ]
              }
            },
            {
              "type": "return",
              "value": {
                "type": "binaryOp",
                "op": "+",
                "left": {
                  "type": "literal",
                  "value": "VIP order processed: "
                },
                "right": {
                  "type": "varRef",
                  "value": "order1"
                }
              }
            }
          ],
          "else": []
        },
        {
          "type": "return",
          "value": {
            "type": "literal",
            "value": "Order queued for processing"
          }
        }
      ],
      "description": "Process multiple orders at once with validation",
      "tools": [
        {
          "description": "Check if enough stock available",
          "params": {
            "product_id": {
              "type": "string",
              "optional": false
            },
            "quantity": {
              "type": "number",
              "optional": false
            }
          },
          "name": "validate_stock",
          "returns": "boolean"
        },
        {
          "description": "Parse comma-separated values",
          "params": {
            "csv_string": {
              "type": "string",
              "optional": false
            }
          },
          "name": "parse_csv",
          "returns": "string"
        }
      ],
      "examples": [
        {
          "target_user_id": {
            "type": "literal",
            "value": "user_1"
          },
          "product_ids": {
            "type": "literal",
            "value": "prod_1,prod_2"
          },
          "quantities": {
            "type": "literal",
            "value": "2,3"
          }
        },
        {
          "target_user_id": {
            "type": "literal",
            "value": "user_1"
          },
          "product_ids": {
            "type": "literal",
            "value": "prod_1,prod_2"
          },
          "quantities": {
            "type": "literal",
            "value": "2,3"
          }
        }
      ]
    }
  ],
