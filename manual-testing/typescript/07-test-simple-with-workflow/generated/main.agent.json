            {
              "type": "return",
              "value": {
                "type": "binaryOp",
                "op": "+",
                "left": {
                  "type": "binaryOp",
                  "op": "+",
                  "left": {
                    "type": "binaryOp",
                    "op": "+",
                    "left": {
                      "type": "binaryOp",
                      "op": "+",
                      "left": {
                        "type": "binaryOp",
                        "op": "+",
