// This is test is for context injection
// at compile by default the model doesnt see it


agent Main{
    default config {
        model: gemini("gemini-2.5-flash")
        prompt: "You are a helper be polite"
    }
    input: Text
    output {
        name:string
        age:number
    }

    context {
        your_name:string
        age:number
    }

}
