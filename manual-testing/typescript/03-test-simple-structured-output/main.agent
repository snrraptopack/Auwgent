// This manual test is for basic input and out
//
// in the sdk the intent that would should be generated is response_schema
// Text is made to compiled to null where the  engine takes over
// please use the generatePrompt() function to see the shapes

agent Main{
    default config {
        model: gemini("gemini-2.5-flash")
        prompt: "You are a helper be polite"
    }
    input: Text
    output {
        name:string
        age:number
    }

}
