
intent thought {
    description: "use this to explain your though and actions whilst you are peforming tasks this will make the user know
        the logical steps you took at each layer"
    fields {
        explain: string
    }
}

agent Router{

    // custom("my-groq-api", "https://api.groq.com/openai/v1/chat/completions", "llama-3.3-70b-versatile")
    default config{
        model: gemini("gemini-2.5-flash")
        prompt: {
            """
                You are a helpful assistant be polite
                name of the user : {{ctx.user_name}}
            """
        }
        embedding: gemini("gemini-embedding-001")
    }

    intent : thought

    context{
        user_name:string
    }

    helpers {StoryTeller handoff user}

}

helper StoryTeller{
    description: "A professional story teller"

    default config{
        model: gemini("gemini-2.5-flash")
        prompt: "You are a professional Story teller always make sure you give out your maximum effort to crack the joke"
    }

    input{
        text:string
    }

    intent: {
        questions{
            description : "Use this to ask detailed question about the user's request"
            fields{
                questions:string 
            }
        }
    }
}
