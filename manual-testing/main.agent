
prompt One{

   example{
    user: "hello"
    assistant: "how may i help you"

    user: "can you help me with something"
    assistant: "sure what is it"
   }

}


agent Test{

    default config{
        model:gemini("gemini-2.5-flash",{
            thinking:"low",
            maxToken:2000
        })
        prompt:"Hello" + One
    }

    input{
        text:string
    }

    output{
        name:string
        age:string
    }

}

