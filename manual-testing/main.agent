
agent Hello {
    input {
        name: string
    }

    context {
        isvip:boolean
        name:string
        person:number
    }

    output {
        name:string @desc "user name"
    }
    
    default config {
        model: gemini("key")
        prompt: "you are a helpfull assistant"

    }

    tools {
        hello(id:string):string @desc "this is a tool"
        amina(name:string):number @desc "do nothing"
    }

    workflow one():string{
        description: "dummy"

        return "nothing"
    }
}