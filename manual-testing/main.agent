import {MainAgentPrompt} from "./prompt"
import {Gemini} from "./models"
import {Hey} from "./types"


prompt Hell{
    """
     {{#if 10 > 10}}
        {{@schema(input)}}
     {{/if}}
    """
}

type A{
    wow:string
}


agent Test{

    default config{
        model:custom("anymodel","")
        prompt:ctx.context
    }

    tool one(id:string):string @desc "simple"

    input{
        text:string
    }

    context{
        username:string
        context:string
    }

    output:Hey | A

    workflow hello(id:A):string{
        description: "hello"
        let a = id.wow

        if (a > 20) {
            
        }
        return ""
    }

}

