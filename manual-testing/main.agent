

agent Test{

    default config{
        model:gemini("gemini-2.5-flash",{
            thinking:"low",
            maxToken:2000
        })
        prompt:"Hello" 
    }

    helpers{Kojo with tools{one} handoff user then continue}
    tool one():string @desc "one"

    workflow hey():string{
        description: "one"

        let a = hlp.Kojo()

        return ""
    }

}

helper Kojo{
    description:"kojo"

    default config{
        model:gemini("gemini-2.5-flash",{
            thinking:"low",
            maxToken:2000
        })
        prompt: "one"
    }
}