agent Basic{

    default config{
        model:openai("....")
        prompt:"a helpful agent"
    }

    // all every call here is from the parent model to select which helper
    helpers{
        BasicHelper1 // helpper with no inhrited tools from parent
        BasicHelper2 with tools {all} // helper with tools from parent all tools
        BasicHelper3 with tools {one} // helper with only tool name one inherited
        BasicHelper4 with tools {all} handoff user // helper with inherited tool all from parent and a handoff to user
        BasicHelper5 with tools {one} handoff user then continue   // helper with inherited tool all from parent and a handoff to user then the parent agent to continue
    }

    tool one():string 
    tool two():string
}

helper BasicHelper1{
    description:"nothing"

    default config{
        model:gemini(".....")
        prompt: "a helperful helper"
    }
}

helper BasicHelper2{
     description:"nothing2"

    default config{
        model:gemini(".....")
        prompt: "a helperful helper"
    }
}

helper BasicHelper3{
     description:"nothing2"

    default config{
        model:gemini(".....")
        prompt: "a helperful helper"
    }
}

helper BasicHelper4{
     description:"nothing2"

    default config{
        model:gemini(".....")
        prompt: "a helperful helper"
    }
}

helper BasicHelper5{
     description:"nothing2"

    default config{
        model:gemini(".....")
        prompt: "a helperful helper"
    }
}