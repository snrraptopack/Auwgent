agent Hello {
    input {
        name: string
    }

    context {
        isvip:boolean
        person:number
    }

    output {
        name:string @desc "user name"
    }
    
    default config {
        model: gemini("key")
        prompt {
            """
            Hello {{input.name}}, you are a helpful assistant
            {{@schema(output)}}
            """
            if(ctx.person == 1){
                return "the number is 1"
            }else{
                return "the number is above 1 and 2"
            }
        }

    }
}