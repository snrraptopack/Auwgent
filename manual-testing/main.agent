import {MainAgentPrompt} from "./prompt"
import {Gemini} from "./models"
import {Hey} from "./types"


prompt Hell{
    """
     {{@schema(input)}}

     {{#if 10 > 10}}
     {{/if}}
    """
}



type A{
    wow:string
}


agent Test{

    default config{
        model:custom("anymodel","www.the url")
        prompt:"Hello" 
    }


    tool one(id:string):string

    input{
        text:string
    }

    context{
        username:string
    }

    output:Hey | A

    workflow hello(id:A):string{
        

        let a = id.wow
        return "hello"
    }

}

