import {GeminiModel} from "./models"

prompt One {
    """
        you are very good assistant
    """

    example {
        user : "hello"
        assistant : "hello my friend"
    }

    example {
        user : "co nimo"
        assistant : "appeared"

        user : "again"
        assistant : "alright"
    }

    """
         A text that came after the example where the user said hello and
         and the assit said hello my friend
    """
}

agent Hello {
    input {
        name: string
    }

    context {
        isvip:boolean
        name:string
        person:number
    }

    output {
        name:string @desc "user name"
    }
    
    default config {
        model: GeminiModel
        prompt: "you are a helpfull assistant" + One + {
            example { 
                user : "was found"
                assistant: "okay"
            }
        }

    }

    tools {
        hello(id:string):string @desc "this is a tool"
        amina(name:string):string @desc "do nothing"
    }

    helpers{
        Again with tools {all} handoff user 
        testing with tools {amina} handoff user then continue
    }

    workflow one():string{
        description: "dummy"

        return "nothing"
    }

    workflow two(value:string):string{
        description: "two"
        let a = amina(value)
        if ( 1 > 3){
            return a
        }
        return amina(value)
    }

    workflow eei(text:string):{name:string,age:number}{
        description: "This calls helper"
        
        parallel {
             transfer to hlp.testing({text:text})
            transfer to hlp.testing({text:text}) then continue
        }

        return {name:"amiher",age:10}
    }
}

helper Again{
    description:"Helper"
    default config{
        model:gemini("2.6")
        prompt: "You are aa helper do things that are nice"
    }

    input {
        text:string
    }

    output:{
        name:string
        age: number
    }
}

helper testing{

     description:"Helper"
    default config{
        model:gemini("2.6")
        prompt: "You are aa helper do things that are nice"
    }

    input {
        text:string
    }

    output:{
        name:string
        age: number
    }
}

