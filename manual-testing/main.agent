import {Gemini} from "./models"

type Student{
    name:string,
    id:string,
    location:string,
    grades:string[]
}


output type Simple{
    text:string 
} 

prompt Alone(user_name:string, id:string){
    """
    You are an ai agent that gives a user concise information about what they do....
    the user name is : {{user_name}} and wit an id of {{id}}

    your output should be in this format though not all field will be required {{@schema(output)}}
    """
}

agent Manger{

    default config{
        model:Gemini
        prompt:Alone(ctx.user_name,ctx.id)
    }

    config another{
        model: openai("gpt-anything")
        prompt:Alone(ctx.user_name,ctx.id)
    }
    context{
        user_name:string,
        id:string
    }

    output: Simple | Student 

    tools{
        get_student_details(id:string):Student @desc "get the deatails of the the student"
        edit_student_details(id:string):Student @desc "edit the details of the student"
    }

    workflow get_student_grade(id:string):string[]{
        description: "used for getting only the grade of the student"
        let result = get_student_details(id)
        return result.grades
    }
}