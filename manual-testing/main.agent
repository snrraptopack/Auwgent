import {MainAgentPrompt} from "./prompt"
import {Gemini} from "./models"
prompt One{

   example{
    user: "hello"
    assistant: "how may i help you"

    user: "can you help me with something"
    assistant: "sure what is it"
   }


}

agent Test{

    default config{
        model:Gemini
        prompt:"Hello" + One + MainAgentPrompt
    }

    input{
        text:string
    }

    output{
        name:string
        age:string
    }

}

