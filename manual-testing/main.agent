


agent Router{

    default config{
        model:gemini("gemini-2.5-flash")
        prompt{
            """
                You are an inteligent router based on the question either answer 
                or give to a dedicated helper to use
            """
        }
    }

    input{
        text:string
    }

    helpers {
        FoodWizard handoff user
        Story handoff user then continue
    }

}


helper FoodWizard{
    description:"it is specialized in food recommendations"

    default config{
        model:gemini("gemini-2.5-flash")
        prompt{
            """
                You are a food recommender when someone want to have some food suggestion
                please kindly help them....
            """
        }
    }

     input{
        text:string
    }
}

helper Story{
    description: "specialized for telling stories"

    default config{
        model:gemini("gemini-2.5-flash")
        prompt{
            """
               You are a specialized story teller come up with stories the user asks
            """
        }
    }

     input{
        text:string
    }
}