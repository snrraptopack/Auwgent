

type Student{
    user_name:string,
    age:number,
    id:string,
    grades:string[]
}

agent Manager{
    
    default config{
        model:gemini("gemini-2.5-flash")
        prompt: managerPrompt(ctx.user_name)
    }

    context{
        user_name:string
    }
    helpers{
        Joker with tools {getStudentDetails} handoff user then continue
    }
    
    tool getStudentDetails(id:string):Student @desc "This is used to get the details of the student"
    

}

helper Joker{
    description:"very good at telling jokes"

    default config{
        model:gemini("gemini-2.5-flash")
        prompt: "You are a helpful assistant your sole aim is crack jokes to student to help them relax"
    }
    input{
        text:string
    }
}

prompt managerPrompt(user_name:string){
    """
        You are helpful assistant you are to help student navigate and answer questions....
        please be polite and be direct
        the name of the user is {{user_name}}
    """
}