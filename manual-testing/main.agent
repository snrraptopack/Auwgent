import {MainAgentPrompt} from "./prompt"
import {Gemini} from "./models"
import {Hey} from "./types"


prompt Hell{
    """
     {{@schema(output)}}

     {{#if 10 > 10}}

     {{/if}}
    """
}



type A{
    wow:string
}


agent Test{

    default config{
        model:custom("anymodel","")
        prompt:ctx.context
    }


    tool one(id:string):string

    input{
        text:string
    }

    context{
        username:string
        context:string
    }

    output:Hey | A

    workflow hello(id:A):string{
        let a = id.wow
        return "hello"
    }

}

