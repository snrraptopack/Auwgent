// Main agent that imports from helpers

import { DataFetcher, User, WelcomePrompt } from "./helpers"

agent MainAgent {
    default config {
        model: openai("gpt-4")
        prompt {
            WelcomePrompt
            "Processing user data..."
        }
    }

    
    input {
        user: User
    }
    
    output {
        result: string @desc "Processing result"
    }
    
    helpers {
        DataFetcher
    }
}
