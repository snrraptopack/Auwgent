
prompt any{
    "hello world"
}


agent TestAutoReg {
    input { message: string }
    context { chatId: string }
    output { reply: string @desc "your reply"}
    
    use lifecycle {
        maxTokens: 4000
        maxMessages: 50
    }

    tools{
        getStudentName(id:string): string @desc "The name of the student"
    }
    
    default config {
        model: gemini("gemini-2.0-flash")
        prompt: any +"You are a helpful assistant."  + {
            "helli"
        }
    }


    workflow hello():string {
        description : "hello"
        return "hello" + 3
    }
}
