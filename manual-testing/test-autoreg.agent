type Product{
    name:string
    id:string
    price:number
}
agent Support{

    input {text:string}
    context{
        isVerified:boolean
        user_id:string
    }

    tool search_product_by_name(name:string):Product @desc "for getting a product by name"
    tool search_product_by_id(id:string):Product @desc "for getting a product by id"
   
    
    workflow flow_product(id:string):{success:boolean,reason:string}{
        description: "This workflow is responsible for buying product but with guards to ensure we reliably make transaction"

        tool purchase_product(product_id:string,user_id:string):boolean @desc "used to purchase a product"

        if(ctx.isVerified != true){
            return {success:false, reason:"user is not verfied"}
        }

        let product_result = purchase_product(id,ctx.user_id)

        if(product_result == true){
            return {success:true, reason:"product bought"}
        }
        
        return {success:false, reason:"could not purchase the product"}
    }

}