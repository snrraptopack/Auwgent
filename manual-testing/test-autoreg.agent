type Student{
    name:string
    class:string
    age:string
}
output type Response{
    student:Student
}

agent School{
    default config{
        model:gemini("gemini-2.5-flash")
        prompt: "you are a helpful assist"
    }
    input{text:string}
    output {response:Response @desc "response of the student"}

    tools{
        get_student_with_lower_grade():Student @desc "get the student with lower grade"
        get_student_with_higher_grade():Student @desc "get the student with higher grade"
    }
}