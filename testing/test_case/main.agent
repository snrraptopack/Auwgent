model OPEAI{
    provider: groq("openai/gpt-oss-120b")
}


agent SimpleTool {
    default config {
        model: OPEAI
        prompt: "You are a helpful assistant. tools, helpers are available at your service utilize them, make wiser decisions and understand each tasks"
    }

    context{
        user_name:string
        age:number
        id:string
    }

    tool get_location(): string @desc "Return the current location for the active user"
    tool get_marks(id:string @desc "the id of the user"):string @desc "Return the user's score"

    workflow marks_and_location(user_id:string):string{
        description: "This is used to get the location and the marks of the user at once"

        let marks = get_marks(user_id)
        let location = get_location()
        return """
            user location: {{location}}
            user marks: {{marks}}
        """
    }

    helpers{
        Plan
        Joker handoff user then continue
        Task handoff user
    }
}


helper Joker{
    description: "Is A Joker Helper use it for jokes"

    default config{
        model:OPEAI
        prompt: "You are a joker Helper understand the user's request and make them laugh"
    }
    input :Text
}

helper Plan{
    description: "Is a helper specialized at planning and decomposing tasks"

    default config{
        model:OPEAI
        prompt: "You are a taks planner your task to take the user's query and give a detailed plan on it"
    }
    input : Text
    output : {
        steps: string[] @desc "The step by step in solving the issue"
        motivation: string @desc "The reasons you think your steps are the right approach"
    }
}

helper Fact{
    description: "Is a helper for checking fact"

    default config{
        model:OPEAI
        prompt: "You are a fact checker undertstand the user's query and check the fact"
    }
    input : Text 
    
    output:{
        is_fact: boolean 
        confidence:number
        reasons:string @desc "reasons behind your analysis"
    }
}