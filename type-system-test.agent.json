{
  "name": "TypeSystemTest",
  "modelConfig": [
    {
      "defaultConfig": {
        "model": {
          "type": "gemini",
          "modelName": "gemini-2.0-flash"
        },
        "prompt": {
          "value": "You are a data analysis assistant.",
          "type": "literal"
        }
      },
      "namedConfig": []
    }
  ],
  "input": {
    "message": {
      "type": "string",
      "optional": false
    }
  },
  "output": {
    "analysis": {
      "type": {
        "type": "typeRef",
        "name": "AnalysisResult"
      },
      "optional": false,
      "description": "The complete analysis"
    },
    "searchResults": {
      "type": {
        "type": "typeRef",
        "name": "SearchResult"
      },
      "optional": false,
      "description": "Related search results"
    }
  },
  "context": {
    "sessionId": {
      "type": "string",
      "optional": false
    }
  },
  "tools": [],
  "workflows": [],
  "helpers": [],
  "types": {
    "Point": {
      "isOutput": false,
      "properties": {
        "x": {
          "type": "number",
          "optional": false
        },
        "y": {
          "type": "number",
          "optional": false
        }
      }
    },
    "Address": {
      "isOutput": false,
      "properties": {
        "street": {
          "type": "string",
          "optional": false
        },
        "city": {
          "type": "string",
          "optional": false
        },
        "zipCode": {
          "type": "string",
          "optional": true
        }
      }
    },
    "User": {
      "isOutput": false,
      "properties": {
        "id": {
          "type": "string",
          "optional": false
        },
        "name": {
          "type": "string",
          "optional": false
        },
        "address": {
          "type": {
            "type": "typeRef",
            "name": "Address"
          },
          "optional": false
        }
      }
    },
    "AnalysisResult": {
      "isOutput": true,
      "properties": {
        "summary": {
          "type": "string",
          "optional": false,
          "description": "High-level summary of findings"
        },
        "confidence": {
          "type": "number",
          "optional": false,
          "description": "Confidence score between 0 and 1"
        },
        "keyFindings": {
          "type": {
            "type": "array",
            "items": "string"
          },
          "optional": false,
          "description": "List of key findings"
        }
      }
    },
    "SearchResult": {
      "isOutput": true,
      "properties": {
        "query": {
          "type": "string",
          "optional": false,
          "description": "The original search query"
        },
        "results": {
          "type": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "title": "string",
                "url": "string",
                "snippet": "string"
              }
            }
          },
          "optional": false,
          "description": "Array of search results"
        },
        "totalCount": {
          "type": "number",
          "optional": false,
          "description": "Total number of results found"
        }
      }
    }
  }
}