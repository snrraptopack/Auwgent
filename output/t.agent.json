{
  "name": "UIMaker",
  "modelConfig": [
    {
      "defaultConfig": {
        "modelName": "kimi-k2-0905-preview",
        "prompt": {
          "type": "parts",
          "value": [
            {
              "value": "You are a ui designer and helper make sure you understand the intent before proceeding",
              "type": "literal"
            },
            {
              "value": "Your task is to analyze the users query understand the intend",
              "type": "literal"
            },
            {
              "value": "formulate the request well, make it clear and handle cases where the user didnt add or improve what they said",
              "type": "literal"
            },
            {
              "value": "propose an initial color scheme and a design pattern we can you then pass it on to the appropriate workflow",
              "type": "literal"
            },
            {
              "value": "You can call a helper directly which will pass the original user intent if you wish to ofload some of the task",
              "type": "literal"
            },
            {
              "value": "we have workflows that will help to design the user's request which should be html css and javascript if some is part",
              "type": "literal"
            }
          ]
        }
      },
      "namedConfig": []
    }
  ],
  "input": {
    "request": {
      "type": "string",
      "optional": false
    }
  },
  "output": {
    "result": {
      "type": "string",
      "description": "Your UI design response",
      "optional": false
    }
  },
  "context": null,
  "tools": [],
  "workflows": [
    {
      "flowName": "fullDesign",
      "flowParams": {
        "query": {
          "type": "string",
          "optional": false
        }
      },
      "returns": "string",
      "body": [
        {
          "name": "design",
          "value": {
            "type": "helperCall",
            "value": "UIPatternMaker",
            "args": [
              {
                "type": "object",
                "value": {
                  "query": {
                    "value": "query",
                    "type": "varRef"
                  }
                }
              }
            ]
          },
          "type": "variableDeclaration"
        },
        {
          "type": "transfer",
          "target": {
            "type": "helperCall",
            "value": "UIProgrammer",
            "args": [
              {
                "type": "object",
                "value": {
                  "design": {
                    "type": "memberAccess",
                    "object": {
                      "type": "varRef",
                      "value": "design"
                    },
                    "properties": [
                      "propose"
                    ]
                  }
                }
              }
            ]
          },
          "mode": "thenContinue"
        },
        {
          "type": "return",
          "value": {
            "type": "template",
            "parts": [
              {
                "type": "expression",
                "value": {
                  "value": "query",
                  "type": "varRef"
                }
              },
              {
                "type": "literal",
                "value": " was done you can choose to continue or wrap give a notice to the user"
              }
            ]
          }
        }
      ],
      "description": "This workflow takes from design planning using the uipattern planner then the uiprogrammer then gives you the final result"
    }
  ],
  "helpers": [
    {
      "name": "UIPatternMaker",
      "description": "Takes the user input carefully analyze it and propose a design solution based on trending and best practices",
      "modelConfig": [
        {
          "defaultConfig": {
            "modelName": "kimi-k2-0905-preview",
            "prompt": {
              "type": "parts",
              "value": [
                {
                  "value": "You are a professional UI pattern descovery, Your task it to analyze come up with unique designs that dont feel anyway but feels modern and natural",
                  "type": "literal"
                },
                {
                  "value": "Critically analyze the task, and make sure you pick the right color combination and other best design practices",
                  "type": "literal"
                }
              ]
            }
          },
          "namedConfig": []
        }
      ],
      "input": {
        "query": {
          "type": "string",
          "optional": false
        }
      },
      "output": {
        "propose": {
          "type": "string",
          "description": "The proposed design solution that needs to be returned",
          "optional": false
        }
      },
      "context": null,
      "tools": [],
      "workflows": []
    },
    {
      "name": "UIProgrammer",
      "description": "Takes The design format analyze it carefully then implement it in pure html,css and javascript",
      "modelConfig": [
        {
          "defaultConfig": {
            "modelName": "kimi-k2-0905-preview",
            "prompt": {
              "type": "parts",
              "value": [
                {
                  "value": "Strictly produce html,css and javscript code that aligns with the design query giving to you",
                  "type": "literal"
                }
              ]
            }
          },
          "namedConfig": []
        }
      ],
      "input": {
        "design": {
          "type": "string",
          "optional": false
        }
      },
      "output": {
        "code": {
          "type": "string",
          "description": "The written code",
          "optional": false
        }
      },
      "context": null,
      "tools": [],
      "workflows": []
    }
  ]
}