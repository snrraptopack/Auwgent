@@type Model = {
    provider: string
    name: string
}

@@type ModelConfig = {}

@@(model, body)
type ModelBody = {
    model: Model
    config?: ModelConfig
}

@@function gemini(name: string,config?: ModelConfig): Model
@@function openai(name: string,config?: ModelConfig): Model
@@function groq(name: string,config?: ModelConfig): Model
