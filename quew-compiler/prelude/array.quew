@@rust("std.array.len")
!@@function array_len<T>(array: T[]): number

@@rust("std.array.get")
!@@function array_get<T>(array: T[], index: number): T?

@@rust("std.array.push")
!@@function array_push<T>(array: T[], item: T): T[]

@@rust("std.array.pop")
!@@function array_pop<T>(array: T[]): T?

extend array{
    function push<T>(item: T): T[] {
        return array_push(self,item)
    }
}
