# ── Rust build artifacts ──────────────────────────────────────────────────────
/target/
**/target/

# Cargo lock is committed for binaries (quew-cli) but not for libraries.
# Since this workspace contains a binary crate (quew-cli), we keep Cargo.lock.
# Remove the line below if you want to ignore it for library-only workspaces.
# Cargo.lock

# ── insta snapshot review files ───────────────────────────────────────────────
# Pending snapshots generated by `cargo insta test` — never commit these.
**/*.pending-snap

# ── IDE / editor files ────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml

# ── OS-generated files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Environment / secrets ────────────────────────────────────────────────────
.env
.env.local
*.env

# ── Benchmark / profiling output ─────────────────────────────────────────────
criterion/
flamegraph.svg
perf.data
perf.data.old
