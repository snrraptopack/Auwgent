{
  "workflow": {
    "description": "Process and transform data from multiple sources",
    "environment": {
      "LOG_LEVEL": "info",
      "MAX_RETRIES": 3.0,
      "NODE_ENV": "production"
    },
    "error_handling": {
      "max_retries": 3.0,
      "notification": {
        "channel": "pagerduty",
        "severity": "critical"
      },
      "on_failure": "notify_and_retry",
      "retry_delay": 300.0
    },
    "name": "data_processing_pipeline",
    "steps": [
      {
        "action": "database.query",
        "config": {
          "connection": "primary_db",
          "query": "SELECT * FROM events WHERE date > NOW() - INTERVAL 1 DAY",
          "timeout": 30000.0
        },
        "name": "extract_data",
        "outputs": [
          "raw_data"
        ]
      },
      {
        "action": "schema.validate",
        "config": {
          "schema": "event_schema_v2",
          "strict": true
        },
        "depends_on": [
          "extract_data"
        ],
        "name": "validate_schema",
        "on_error": "skip_invalid"
      },
      {
        "action": "transform.map",
        "config": {
          "mapping": {
            "id": "event_id",
            "payload": "data",
            "timestamp": "created_at",
            "type": "event_type"
          }
        },
        "depends_on": [
          "validate_schema"
        ],
        "name": "transform_data"
      },
      {
        "action": "api.call",
        "config": {
          "batch_size": 100.0,
          "endpoint": "https://enrichment.api.example.com/enrich",
          "method": "POST",
          "retry": {
            "attempts": 3.0,
            "delay": 1000.0
          }
        },
        "depends_on": [
          "transform_data"
        ],
        "name": "enrich_data"
      },
      {
        "action": "warehouse.insert",
        "config": {
          "destination": "analytics_warehouse",
          "mode": "append",
          "partition_by": "date",
          "table": "processed_events"
        },
        "depends_on": [
          "enrich_data"
        ],
        "name": "load_warehouse"
      },
      {
        "action": "notification.send",
        "config": {
          "channel": "slack",
          "message": "Pipeline completed successfully",
          "webhook": "https://hooks.slack.com/services/xxx"
        },
        "depends_on": [
          "load_warehouse"
        ],
        "name": "notify_complete"
      }
    ],
    "triggers": [
      {
        "cron": "0 0 * * *",
        "timezone": "UTC",
        "type": "schedule"
      },
      {
        "auth": "bearer",
        "method": "POST",
        "path": "/api/trigger",
        "type": "webhook"
      }
    ],
    "version": "1.0.0"
  }
}