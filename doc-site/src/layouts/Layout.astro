---
import '../styles/global.css';
import Navbar from '../components/common/Navbar.astro';

interface Props { title: string; }
const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<title>{title}</title>
	</head>
	<body class="bg-surface text-text-secondary antialiased min-h-screen flex flex-col relative">
		
		<!-- The Gradient is fixed to the very top of the page, behind the Navbar and Hero -->
		<span class="block fixed inset-0 pointer-events-none -z-10 h-[1000px]" style="background:radial-gradient(49.63% 57.02% at 50% 0%, rgba(255, 115, 168, 0.08) 0%, rgba(0, 0, 0, 0) 100%)"></span>

		<Navbar />

		<div class="flex-grow pt-14"> <!-- pt-14 matches the height of the Bun navbar -->
			<slot /> 
		</div>

	</body>
</html>
