---
// src/components/common/Navbar.astro
---

<!-- Fully transparent background so the page gradient shows through naturally -->
<header class="absolute top-0 w-full z-50 bg-transparent border-b border-transparent">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="flex items-center justify-between h-14">
      
      <!-- 1. LEFT: Logo -->
      <div class="flex-shrink-0 flex items-center gap-2 cursor-pointer">
        <div class="w-6 h-6 bg-gray-900 rounded-md flex items-center justify-center text-white font-bold text-xs">
          A
        </div>
        <span class="font-bold text-lg text-gray-900 tracking-tight">Auwgent</span>
      </div>

      <!-- 2. CENTER: Desktop Navigation Links -->
      <nav class="hidden md:flex space-x-6">
        <a href="/docs" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Docs</a>
        <a href="/playground" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Playground</a>
        <a href="/examples" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Examples</a>
        <a href="/blog" class="text-sm font-medium text-gray-600 hover:text-gray-900 transition-colors">Blog</a>
      </nav>

      <!-- 3. RIGHT: Actions -->
      <div class="flex items-center gap-4">
        
        <!-- GitHub Icon -->
        <a href="https://github.com/snrraptopack/auwgent" class="hidden sm:block text-gray-400 hover:text-gray-900 transition-colors">
          <span class="sr-only">GitHub</span>
          <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24">
             <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd" />
          </svg>
        </a>

        <!-- Bun-style Secondary Button -->
        <a href="/docs/getting-started" class="hidden sm:inline-flex items-center justify-center px-3 py-1.5 text-sm font-medium text-gray-700 bg-gray-950/[0.03] hover:bg-gray-950/10 rounded-xl transition-colors">
          Get Started
        </a>

        <!-- Mobile menu button -->
        <button class="md:hidden p-2 text-gray-500 hover:text-gray-900">
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>
    </div>
  </div>
</header>
