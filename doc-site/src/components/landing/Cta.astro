---
// src/components/landing/Cta.astro
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
  <div class="bg-gray-950 rounded-3xl p-10 sm:p-16 text-center relative overflow-hidden shadow-2xl">
    
    <!-- Subtle glow/pattern behind -->
    <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-brand-900/20 via-transparent to-transparent opacity-50"></div>
    
    <div class="relative z-10 max-w-2xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mb-4">
        Ready to build?
      </h2>
      <p class="text-[17px] text-gray-400 mb-8 leading-relaxed">
        Join the ecosystem. Compile your first agent into native, production-ready code in less than 5 minutes.
      </p>
      
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/docs/getting-started" class="inline-flex justify-center items-center px-6 py-3 rounded-xl bg-white text-gray-950 text-[15px] font-bold hover:bg-gray-100 transition-colors shadow-sm">
          Get Started
        </a>
        <a href="https://github.com/snrraptopack/auwgent" class="inline-flex justify-center items-center px-6 py-3 rounded-xl bg-gray-900 text-white text-[15px] font-bold border border-gray-800 hover:bg-gray-800 transition-colors shadow-sm">
          View GitHub
        </a>
      </div>
    </div>
    
  </div>
</section>
