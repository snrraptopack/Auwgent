---
// src/components/landing/Hero.astro
---

<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-16 lg:pb-24 pt-0">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
    
    <!-- ==========================================
         LEFT COLUMN: TEXT & CTA
         ========================================== -->
    <div class="flex flex-col items-start mt-4 lg:mt-8">
      
      <!-- The stark, native-feeling headline -->
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold text-gray-900 tracking-tight leading-[1.1] mb-6">
        Write AI agents. <br/> Compile anywhere.
      </h1>

      <!-- The crisp, slightly smaller body text -->
      <p class="text-[17px] text-gray-600 mb-8 max-w-lg leading-relaxed font-normal">
        Auwgent is an all-in-one toolkit and domain-specific language for building, optimizing, and deploying AI agents natively in Rust, Dart, Python, and TypeScript.
      </p>

      <!-- The Buttons -->
      <div class="flex flex-col sm:flex-row gap-4 mb-10">
        <!-- Bun Primary Button: Pitch Black, slightly rounded -->
        <a href="/docs/getting-started" class="inline-flex justify-center items-center px-5 py-2.5 rounded-[10px] bg-black text-white text-[15px] font-semibold hover:bg-gray-800 transition-colors shadow-sm">
          Get Started
        </a>
        <!-- Bun Secondary Button: Outlined, stark white -->
        <a href="/playground" class="inline-flex justify-center items-center px-5 py-2.5 rounded-[10px] bg-white text-gray-700 text-[15px] font-semibold border border-gray-300 hover:bg-gray-50 transition-colors shadow-sm">
          View Documentation
        </a>
      </div>

      <!-- Feature ticks below buttons -->
      <div class="flex items-center gap-6 text-sm text-gray-500 font-medium">
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Multi-target</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Type-safe</span>
        <span class="flex items-center gap-1.5"><svg class="w-4 h-4 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" /></svg> Optimized</span>
      </div>
    </div>

    <!-- ==========================================
         RIGHT COLUMN: THE DIAGRAM
         ========================================== -->
    <div class="relative w-full aspect-square sm:aspect-[4/3] lg:aspect-square flex flex-col justify-center items-center">
      
      <!-- Top Node: The DSL (Stark white card) -->
      <div class="w-full max-w-xs bg-white rounded-2xl p-4 border border-gray-950/10 text-center relative z-10 shadow-sm">
        <div class="flex items-center justify-center gap-3 mb-1">
          <div class="w-8 h-8 bg-gray-50 rounded-lg flex items-center justify-center text-gray-900 font-bold border border-gray-100">A</div>
          <h3 class="font-bold text-gray-900 text-lg tracking-tight">Auwgent</h3>
        </div>
        <p class="text-xs text-gray-500">Describe your agent once</p>
      </div>

      <!-- Perfect Connector Space -->
      <div class="relative w-full h-24 sm:h-32 -my-2 z-0">
        <svg class="absolute inset-0 w-full h-full pointer-events-none" viewBox="0 0 100 100" preserveAspectRatio="none">
          <style>
            .flow-line { stroke-dasharray: 2; animation: flow 1s linear infinite; }
            @keyframes flow { to { stroke-dashoffset: -4; } }
          </style>
          <!-- Paths perfectly map from Y=15 (bottom of top node) to Y=85 (top of bottom nodes) -->
          <path class="flow-line" d="M 50 15 C 50 50, 10 50, 10 85" stroke="#ff73a8" stroke-width="0.4" stroke-opacity="0.8" fill="none" vector-effect="non-scaling-stroke"/>
          <path class="flow-line" d="M 50 15 C 50 50, 36 50, 36 85" stroke="#ff73a8" stroke-width="0.4" stroke-opacity="0.8" fill="none" vector-effect="non-scaling-stroke"/>
          <path class="flow-line" d="M 50 15 C 50 50, 64 50, 64 85" stroke="#ff73a8" stroke-width="0.4" stroke-opacity="0.8" fill="none" vector-effect="non-scaling-stroke"/>
          <path class="flow-line" d="M 50 15 C 50 50, 90 50, 90 85" stroke="#ff73a8" stroke-width="0.4" stroke-opacity="0.8" fill="none" vector-effect="non-scaling-stroke"/>
        </svg>
      </div>

      <!-- Bottom Nodes: Targets (Bun style cards) -->
      <div class="w-full grid grid-cols-4 gap-3 sm:gap-4 relative z-10">
        
        <!-- Rust -->
        <div class="bg-white rounded-2xl p-3 border border-gray-950/10 text-center flex flex-col items-center hover:border-brand-500 transition-colors cursor-pointer group shadow-sm hover:shadow-md">
          <div class="mb-3 mt-1 flex items-center justify-center">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/rust/rust-original.svg" alt="Rust Logo" class="w-8 h-8" />
          </div>
          <span class="font-semibold text-sm text-gray-900 mb-1">Rust</span>
          <span class="text-[10px] text-gray-500 leading-tight">Safe & fast</span>
        </div>

        <!-- Dart -->
        <div class="bg-white rounded-2xl p-3 border border-gray-950/10 text-center flex flex-col items-center hover:border-brand-500 transition-colors cursor-pointer group shadow-sm hover:shadow-md">
          <div class="mb-3 mt-1 flex items-center justify-center">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/dart/dart-original.svg" alt="Dart Logo" class="w-8 h-8" />
          </div>
          <span class="font-semibold text-sm text-gray-900 mb-1">Dart</span>
          <span class="text-[10px] text-gray-500 leading-tight">Native apps</span>
        </div>

        <!-- Python -->
        <div class="bg-white rounded-2xl p-3 border border-gray-950/10 text-center flex flex-col items-center hover:border-brand-500 transition-colors cursor-pointer group shadow-sm hover:shadow-md">
          <div class="mb-3 mt-1 flex items-center justify-center">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/python/python-original.svg" alt="Python Logo" class="w-8 h-8" />
          </div>
          <span class="font-semibold text-sm text-gray-900 mb-1">Python</span>
          <span class="text-[10px] text-gray-500 leading-tight">AI models</span>
        </div>

        <!-- TypeScript -->
        <div class="bg-white rounded-2xl p-3 border border-gray-950/10 text-center flex flex-col items-center hover:border-brand-500 transition-colors cursor-pointer group shadow-sm hover:shadow-md">
          <div class="mb-3 mt-1 flex items-center justify-center">
            <img src="https://cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/typescript/typescript-original.svg" alt="TypeScript Logo" class="w-7 h-7 rounded-[3px]" />
          </div>
          <span class="font-semibold text-sm text-gray-900 mb-1">TypeScript</span>
          <span class="text-[10px] text-gray-500 leading-tight">Web & Node</span>
        </div>

      </div>

    </div>

  </div>
</section>
